# ── Секреты (заполни на сервере, НЕ коммить) ─────────────────────────────
OPENAI_API_KEY=
BOT_TOKEN=
# Любая случайная строка (a-z0-9, до 256 симв.) — тот же секрет передай в setWebhook,
# см. deploy/webhook.md. Пусто = проверка выключена.
TG_WEBHOOK_SECRET=

# ── LLM ──────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=60000

# ── Приложение ───────────────────────────────────────────────────────────
PORT=3000
# Базовый путь, под которым живёт приложение (подпапка домена)
BASE_PATH=/Yasno-growth-bot
# Публичный URL мини-аппа (для кнопок в боте)
PUBLIC_URL=https://inshinlab.com/Yasno-growth-bot/
# Путь к файлу базы SQLite
DB_PATH=./data/yasno.sqlite

# ── Dev-режим ────────────────────────────────────────────────────────────
# true → пускать запросы без подписи Telegram (ТОЛЬКО локальная разработка)
ALLOW_DEV_NO_AUTH=false
